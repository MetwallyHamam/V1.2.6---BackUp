APP_ENV=local
APP_NAME=Millensys Support Hub
APP_VERSION=0.1.0
SECRET_KEY=replace-via-secret-manager
DATABASE_URL=mssql+pyodbc://user:password@server/database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=https://support.example.com
ATTACHMENT_STORAGE_PROVIDER=local
ATTACHMENT_ROOT=/var/lib/support-hub/attachments
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace
SMTP_PASSWORD=replace-via-secret-manager
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
