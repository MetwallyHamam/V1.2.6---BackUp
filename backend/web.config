<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Millensys Support Hub - IIS backend configuration

    Required IIS component:
      HttpPlatformHandler

    Before deployment:
      1. Replace every REPLACE_* value.
      2. Keep the packaged runtime folder beside this file.
      3. Run: runtime\SupportHubBackend.exe migrate
      4. Run: runtime\SupportHubBackend.exe seed

    Do not commit real production credentials. Prefer injecting secrets through
    the server/environment or a secret manager and restricting this file's ACL.
  -->
  <system.webServer>
    <!-- Requires the IIS WebSocket Protocol role service. Preserve Upgrade headers to Uvicorn. -->
    <webSocket enabled="true" />
    <urlCompression doStaticCompression="true" doDynamicCompression="true" dynamicCompressionBeforeCache="true" />
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <remove name="httpPlatformHandler" />
      <add
        name="httpPlatformHandler"
        path="*"
        verb="*"
        modules="httpPlatformHandler"
        resourceType="Unspecified"
      />
    </handlers>

    <httpPlatform
      processPath=".\runtime\SupportHubBackend.exe"
      arguments="serve --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\uvicorn"
      startupTimeLimit="120"
      startupRetryCount="5"
      requestTimeout="00:05:00"
      processesPerApplication="2"
    >
      <environmentVariables>
        <!-- Application -->
        <environmentVariable name="APP_ENV" value="production" />
        <environmentVariable name="APP_NAME" value="Millensys Support Hub" />
        <environmentVariable name="APP_VERSION" value="1.51.1" />
        <environmentVariable
          name="SECRET_KEY"
          value="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
        />

        <!--
          SQL Server / FreeTDS (pymssql)
          URL-encode special characters in username and password.
          This local driver avoids the host's broken ODBC/Schannel path.
        -->
        <environmentVariable
          name="DATABASE_URL"
          value="REPLACE_WITH_SECRET_IN_SERVER_ENVIRONMENT"
        />
        <!-- Two API processes x (5 pooled + 5 overflow) cap this tier at 20 SQL connections. -->
        <environmentVariable name="DATABASE_POOL_SIZE" value="5" />
        <environmentVariable name="DATABASE_MAX_OVERFLOW" value="5" />
        <environmentVariable name="DATABASE_POOL_TIMEOUT_SECONDS" value="15" />
        <environmentVariable name="DATABASE_POOL_RECYCLE_SECONDS" value="1800" />
        <!-- IIS owns process recycling. Configure staggered application-pool
             recycling in IIS when required; the API workers remain resident. -->

        <!-- Browser/API -->
        <environmentVariable
          name="FRONTEND_ORIGIN"
          value="https://support.example.com"
        />
        <environmentVariable name="TRUSTED_HOSTS" value="localhost,127.0.0.1" />
        <environmentVariable name="APPLICATION_PATH_BASE" value="/SupportHub/backend" />
        <environmentVariable name="FRONTEND_BASE_URL" value="https://millensysonline.net/SupportHub" />
        <environmentVariable name="MAX_REQUEST_BYTES" value="10485760" />
        <environmentVariable name="ATTACHMENT_STORAGE_PATH" value=".\storage\attachments" />
        <environmentVariable name="ATTACHMENT_MAX_BYTES" value="8388608" />
        <environmentVariable name="DATABASE_BACKUP_PATH" value="..\backups" />
        <!-- Daily JSON error/exception logs; IIS stdout logs remain separate for process diagnostics. -->
        <environmentVariable name="ERROR_LOG_ENABLED" value="true" />
        <environmentVariable name="ERROR_LOG_PATH" value=".\logs\errors" />
        <environmentVariable name="ERROR_LOG_TIMEZONE" value="Africa/Cairo" />
        <environmentVariable name="ERROR_LOG_RETENTION_DAYS" value="30" />
        <environmentVariable name="ERROR_LOG_MAX_TOTAL_MB" value="512" />
        <environmentVariable name="ERROR_LOG_COMPRESS_ARCHIVES" value="true" />
        <environmentVariable name="DEPLOYMENT_INSTANCE_ID" value="support-hub-primary" />
        <environmentVariable name="ESCALATION_SCHEDULER_ENABLED" value="true" />
        <environmentVariable name="ESCALATION_SCHEDULER_INTERVAL_SECONDS" value="120" />
        <environmentVariable name="ESCALATION_SCHEDULER_BATCH_SIZE" value="500" />
        <!-- Local Ollama AI gateway. Keep this on loopback when installed on the same server. -->
        <environmentVariable name="LOCAL_AI_ENABLED" value="true" />
        <environmentVariable name="LOCAL_AI_BASE_URL" value="http://127.0.0.1:8090" />
        <environmentVariable name="LOCAL_AI_TIMEOUT_SECONDS" value="120" />

        <!-- Authentication -->
        <environmentVariable name="ACCESS_TOKEN_MINUTES" value="15" />
        <environmentVariable name="REFRESH_TOKEN_DAYS" value="7" />
        <environmentVariable name="LOGIN_MAX_FAILURES" value="5" />
        <environmentVariable name="LOGIN_LOCKOUT_MINUTES" value="15" />
        <!-- Two Argon2 checks per process bounds peak password-hashing memory. -->
        <environmentVariable name="LOGIN_HASH_CONCURRENCY_PER_PROCESS" value="2" />
        <environmentVariable name="LOGIN_HASH_WAIT_SECONDS" value="15" />
        <environmentVariable name="PASSWORD_RESET_MINUTES" value="30" />
        <environmentVariable name="PASSWORD_RESET_ALLOWED_DOMAINS" value="millensys.com,alfascan.com" />

        <!-- External integrations: replace this key before exposing the endpoint. -->
        <environmentVariable name="MONITORING_WEBHOOK_KEY" value="REPLACE_WITH_A_RANDOM_INTEGRATION_KEY" />
        <environmentVariable name="INBOUND_EMAIL_WEBHOOK_KEY" value="REPLACE_WITH_A_RANDOM_EMAIL_INTEGRATION_KEY" />
        <environmentVariable name="INTEGRATION_ACTOR_USERNAME" value="admin" />

        <!-- Microsoft Graph Outlook integration. Keep secrets protected and outside Site Settings. -->
        <environmentVariable name="MICROSOFT_GRAPH_TENANT_ID" value="" />
        <environmentVariable name="MICROSOFT_GRAPH_CLIENT_ID" value="" />
        <environmentVariable name="MICROSOFT_GRAPH_CLIENT_SECRET" value="" />
        <environmentVariable name="MICROSOFT_GRAPH_CLIENT_STATE" value="" />
        <environmentVariable name="MICROSOFT_GRAPH_NOTIFICATION_URL" value="https://millensysonline.net/SupportHub/backend/api/v1/system/outlook-email/webhook" />
        <environmentVariable name="MICROSOFT_GRAPH_LIFECYCLE_URL" value="https://millensysonline.net/SupportHub/backend/api/v1/system/outlook-email/lifecycle" />
        <environmentVariable name="MICROSOFT_GRAPH_TIMEOUT_SECONDS" value="20" />

        <!-- Outbound email. SMTP remains disabled until valid server details are supplied. -->
        <environmentVariable name="SMTP_ENABLED" value="false" />
        <environmentVariable name="SMTP_HOST" value="localhost" />
        <environmentVariable name="SMTP_PORT" value="587" />
        <environmentVariable name="SMTP_USERNAME" value="" />
        <environmentVariable name="SMTP_PASSWORD" value="" />
        <environmentVariable name="SMTP_FROM_ADDRESS" value="support@localhost" />
        <environmentVariable name="SMTP_FROM_NAME" value="Millensys Support Hub" />
        <environmentVariable name="SMTP_USE_TLS" value="true" />
        <environmentVariable name="EMAIL_MAX_ATTEMPTS" value="5" />

        <!-- Provider-neutral SMS gateway (JSON POST). -->
        <environmentVariable name="SMS_ENABLED" value="false" />
        <environmentVariable name="SMS_GATEWAY_URL" value="http://localhost:8080/messages" />
        <environmentVariable name="SMS_API_TOKEN" value="" />
        <environmentVariable name="SMS_SENDER_ID" value="Millensys" />
        <environmentVariable name="SMS_MAX_ATTEMPTS" value="5" />

        <!-- Optional Microsoft Teams incoming webhook. -->
        <environmentVariable name="TEAMS_ENABLED" value="false" />
        <environmentVariable name="TEAMS_WEBHOOK_URL" value="" />
        <environmentVariable name="TEAMS_MAX_ATTEMPTS" value="5" />

        <!--
          Development bootstrap account.
          Leave these empty in production after creating named administrator accounts.
        -->
        <environmentVariable name="DEV_ADMIN_USERNAME" value="" />
        <environmentVariable name="DEV_ADMIN_EMAIL" value="" />
        <environmentVariable name="DEV_ADMIN_PASSWORD" value="" />
      </environmentVariables>
    </httpPlatform>

    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true">
          <clear />
        </verbs>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add
          name="Permissions-Policy"
          value="camera=(), microphone=(), geolocation=()"
        />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
