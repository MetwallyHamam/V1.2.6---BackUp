APP_ENV=local
APP_NAME=Millensys Support Hub
APP_VERSION=0.1.0
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=mssql+pyodbc://user:password@server/database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# SQL Server READ UNCOMMITTED is equivalent to WITH (NOLOCK) on all reads.
DATABASE_READ_UNCOMMITTED=true
WORKER_MAX_REQUESTS=10000
WORKER_MAX_REQUESTS_JITTER=1000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_ALLOWED_DOMAINS=millensys.com,alfascan.com
# Root directory for every system attachment and document. Use an absolute,
# persistent path in IIS production and grant the application-pool identity modify access.
ATTACHMENT_STORAGE_PATH=D:/MillensysSupportHub/storage
ATTACHMENT_MAX_BYTES=8388608
DATABASE_BACKUP_PATH=../backups
# Daily application exception logs. IIS/Uvicorn stdout logs remain enabled separately.
ERROR_LOG_ENABLED=true
ERROR_LOG_PATH=./logs/errors
ERROR_LOG_TIMEZONE=Africa/Cairo
ERROR_LOG_RETENTION_DAYS=30
ERROR_LOG_MAX_TOTAL_MB=512
ERROR_LOG_COMPRESS_ARCHIVES=true
DEPLOYMENT_INSTANCE_ID=support-hub-primary
ESCALATION_SCHEDULER_ENABLED=true
ESCALATION_SCHEDULER_INTERVAL_SECONDS=60
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://127.0.0.1:8090
LOCAL_AI_TIMEOUT_SECONDS=120
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
DEV_ADMIN_USERNAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
